PORT=4100
HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Must match apps/api/.env. Keep this service on the private network.
AI_INTERNAL_TOKEN=
MEDICONNECT_API_URL=http://127.0.0.1:4000/api/v1
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# First index build may download weights; set false for offline deployments.
ALLOW_MODEL_DOWNLOAD=true
RAG_MIN_SCORE=0.3
