
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug


DATABASE_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Generate a unique secret; no development fallback is used.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Redis stores OTP challenges, attempt limits and one-use password-reset grants.
REDIS_URL=redis://localhost:6379

# Separate from JWT_SECRET; required. Never expose OTP in logs/responses.
OTP_HMAC_SECRET=
# Zalo ZBS template credentials; optional until phone registration is enabled.
ZALO_ACCESS_TOKEN=
ZALO_OTP_TEMPLATE_ID=
# Exact OTP parameter name in your approved authentication template.
ZALO_OTP_CODE_PARAM=
