
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug


DATABASE_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Generate a unique secret; no development fallback is used.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Redis stores OTP challenges, attempt limits and one-use password-reset grants.
REDIS_URL=redis://localhost:6379

# Separate from JWT_SECRET; required. OTP is returned only in explicit dev/test mode.
OTP_HMAC_SECRET=
# Local/testing only: skip external delivery and return the generated code to the UI.
OTP_DEV_MODE=false
# Zalo ZBS template credentials; optional until phone registration is enabled.
ZALO_ACCESS_TOKEN=
ZALO_OTP_TEMPLATE_ID=
# Exact OTP parameter name in your approved authentication template.
ZALO_OTP_CODE_PARAM=

# AI inference service; use the same random token in apps/ai/.env.
AI_SERVICE_URL=http://127.0.0.1:4100
AI_INTERNAL_TOKEN=

# TextBee SMS gateway and manual test script.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_API_URL=https://api.textbee.dev/api/v1/gateway
# Server-only Cloudinary credentials for doctor avatars.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mediconnect
